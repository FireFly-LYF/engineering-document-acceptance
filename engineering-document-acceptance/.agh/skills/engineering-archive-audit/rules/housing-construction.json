{
  "profile_id": "housing-construction",
  "project_type": "房屋建筑工程",
  "version": "0.2.0",
  "basis_note": "示例可配置清单",
  "manifest_fields": [
    {
      "key": "project_name",
      "name": "项目名称",
      "type": "text",
      "required": true,
      "aliases": ["工程名称", "建设项目名称"],
      "consistency": "global",
      "consistency_note": "工程身份：凡有文载项目名称的本工程文件均应与任务/manifest 一致"
    },
    {
      "key": "project_code",
      "name": "项目编号",
      "type": "identifier",
      "required": true,
      "aliases": ["工程编号", "建设项目编号", "编号"],
      "consistency": "global",
      "consistency_note": "工程身份编号：有值文件全局应一致"
    },
    {
      "key": "owner",
      "name": "建设单位",
      "type": "organization",
      "required": true,
      "consistency": "scoped"
    },
    {
      "key": "contractor",
      "name": "施工单位",
      "type": "organization",
      "required": true,
      "consistency": "scoped"
    },
    {
      "key": "supervisor",
      "name": "监理单位",
      "type": "organization",
      "required": true,
      "consistency": "scoped"
    },
    {
      "key": "designer",
      "name": "设计单位",
      "type": "organization",
      "required": false,
      "consistency": "scoped"
    },
    {
      "key": "address",
      "name": "工程地址",
      "type": "text",
      "required": false,
      "aliases": ["建设地点", "建设地址", "工程地点", "建设位置"],
      "consistency": "scoped"
    },
    {
      "key": "start_date",
      "name": "开工日期",
      "type": "date",
      "required": false,
      "consistency": "scoped"
    },
    {
      "key": "finish_date",
      "name": "竣工日期",
      "type": "date",
      "required": false,
      "consistency": "scoped"
    },
    {
      "key": "contract_amount",
      "name": "合同金额",
      "type": "money",
      "required": false,
      "aliases": ["签约合同价", "合同价格", "合同金额（元）"],
      "consistency": "scoped",
      "consistency_note": "仅在施工合同/竣工类等使用文件类别内与 manifest 或彼此比对；监理类不适用"
    }
  ],
  "primary_reference": {
    "code": "A-02",
    "name": "建筑工程施工许可证",
    "aliases": ["施工许可证", "开工证", "建设工程施工许可证"]
  },
  "required_documents": [
    {
      "code": "A-01",
      "name": "建设工程规划许可证",
      "required": true,
      "stage": "工程准备",
      "category": "preparation",
      "aliases": ["规划许可证", "建设用地规划许可证"]
    },
    {
      "code": "A-02",
      "name": "建筑工程施工许可证",
      "required": true,
      "stage": "工程准备",
      "category": "preparation",
      "aliases": ["施工许可证", "开工证", "建设工程施工许可证"]
    },
    {
      "code": "A-03",
      "name": "施工合同",
      "required": true,
      "stage": "工程准备",
      "category": "contract",
      "aliases": ["建设工程施工合同", "承包合同"]
    },
    {
      "code": "A-04",
      "name": "监理合同",
      "required": true,
      "stage": "工程准备",
      "category": "contract",
      "aliases": ["建设工程委托监理合同"]
    },
    {
      "code": "B-01",
      "name": "监理规划",
      "required": true,
      "stage": "监理",
      "category": "supervision",
      "aliases": ["监理规划书"]
    },
    {
      "code": "B-02",
      "name": "监理实施细则",
      "required": false,
      "stage": "监理",
      "category": "supervision",
      "aliases": ["专业监理实施细则"]
    },
    {
      "code": "B-03",
      "name": "监理评估报告",
      "required": true,
      "stage": "监理",
      "category": "supervision",
      "aliases": ["工程质量评估报告", "监理质量评估报告"]
    },
    {
      "code": "C-01",
      "name": "施工组织设计",
      "required": true,
      "stage": "施工",
      "category": "construction",
      "aliases": ["施工组织设计方案", "施组"]
    },
    {
      "code": "C-02",
      "name": "检验批质量验收记录",
      "required": true,
      "stage": "施工",
      "category": "construction",
      "aliases": ["检验批验收记录", "检验批"]
    },
    {
      "code": "C-03",
      "name": "分项工程质量验收记录",
      "required": true,
      "stage": "施工",
      "category": "construction",
      "aliases": ["分项工程验收记录"]
    },
    {
      "code": "C-04",
      "name": "分部工程质量验收记录",
      "required": true,
      "stage": "施工",
      "category": "construction",
      "aliases": ["分部工程验收记录"]
    },
    {
      "code": "D-01",
      "name": "材料进场报审及复试报告",
      "required": true,
      "stage": "材料检测",
      "category": "material_test",
      "aliases": ["材料复试报告", "进场验收记录", "检测报告"]
    },
    {
      "code": "E-01",
      "name": "工程竣工验收报告",
      "required": true,
      "stage": "竣工验收",
      "category": "completion_acceptance",
      "aliases": ["工程质量竣工验收报告", "竣工验收报告"],
      "notes": "预验收报告、自检报告默认不能替代本项，除非项目清单明确允许。"
    },
    {
      "code": "E-02",
      "name": "施工单位工程竣工报告",
      "required": true,
      "stage": "竣工验收",
      "category": "completion_acceptance",
      "aliases": ["竣工报告", "施工竣工报告"]
    },
    {
      "code": "E-03",
      "name": "设计单位工程质量检查报告",
      "required": true,
      "stage": "竣工验收",
      "category": "completion_acceptance",
      "aliases": ["设计检查报告", "设计单位检查报告"]
    },
    {
      "code": "F-01",
      "name": "竣工图",
      "required": true,
      "stage": "竣工图",
      "category": "as_built_drawing",
      "aliases": ["工程竣工图", "建筑竣工图"]
    },
    {
      "code": "G-01",
      "name": "消防验收意见或备案凭证",
      "required": true,
      "stage": "专项验收",
      "category": "special_acceptance",
      "aliases": ["消防验收", "消防备案", "建设工程消防验收意见书"]
    },
    {
      "code": "G-02",
      "name": "规划核实证明",
      "required": false,
      "stage": "专项验收",
      "category": "special_acceptance",
      "aliases": ["规划核实", "建设工程规划核实合格证"]
    }
  ],
  "consistency_rules": [
    {
      "rule_id": "R-001",
      "name": "字段适用范围",
      "type": "field_scope",
      "note": "consistency=global 的字段不配 documents（全库有值即适用）；scoped 字段仅在下列使用文件类别中参与 R-002/R-003",
      "scopes": [
        {
          "field": "owner",
          "documents": [
            "建筑工程施工许可证",
            "施工许可证",
            "施工合同",
            "监理合同",
            "工程竣工验收报告"
          ]
        },
        {
          "field": "contractor",
          "documents": [
            "建筑工程施工许可证",
            "施工许可证",
            "施工合同",
            "施工单位工程竣工报告",
            "工程竣工验收报告"
          ]
        },
        {
          "field": "supervisor",
          "documents": [
            "监理合同",
            "监理规划",
            "监理评估报告",
            "工程质量评估报告"
          ]
        },
        {
          "field": "designer",
          "documents": [
            "建筑工程施工许可证",
            "施工许可证",
            "设计单位工程质量检查报告",
            "工程竣工验收报告"
          ]
        },
        {
          "field": "address",
          "documents": [
            "建筑工程施工许可证",
            "施工许可证",
            "施工合同",
            "工程竣工验收报告"
          ]
        },
        {
          "field": "start_date",
          "documents": [
            "建筑工程施工许可证",
            "施工许可证",
            "施工合同",
            "施工单位工程竣工报告"
          ]
        },
        {
          "field": "finish_date",
          "documents": [
            "施工单位工程竣工报告",
            "工程竣工验收报告"
          ]
        },
        {
          "field": "contract_amount",
          "documents": [
            "施工合同",
            "施工单位工程竣工报告",
            "工程竣工验收报告"
          ]
        }
      ]
    },
    {
      "rule_id": "R-002",
      "name": "manifest 字段一致性",
      "type": "manifest_consistency",
      "operator": "all_values_equal"
    },
    {
      "rule_id": "R-003",
      "name": "无 manifest 值时的跨文件一致性",
      "type": "cross_file_consistency",
      "operator": "all_values_equal",
      "min_coverage": 0.25,
      "only_when_manifest_empty": true
    }
  ]
}
