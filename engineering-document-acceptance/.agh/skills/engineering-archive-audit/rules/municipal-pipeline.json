{
  "profile_id": "municipal-pipeline",
  "project_type": "市政管线工程",
  "version": "0.3.0",
  "basis_note": "可配置清单，结构对齐 GB/T 50328 地下管线归档范围（B.0.3）及地方公开目录（韶关档案编制指南附录 D、江门统一目录第三部分管线工程、地下管线工程资料管理技术规程）。非某一地市/专业管线全文照录；给水/排水/燃气/电力/电信等可用 aliases 兼容。参考 PDF 见 reference/municipal-pipeline/ 与 reference/archive-catalogs/。",
  "manifest_fields": [
    {
      "key": "project_name",
      "name": "项目名称",
      "type": "text",
      "required": true,
      "aliases": ["工程名称", "建设项目名称"]
    },
    {
      "key": "project_code",
      "name": "项目编号",
      "type": "identifier",
      "required": true,
      "aliases": ["工程编号", "建设项目编号", "编号"]
    },
    {
      "key": "owner",
      "name": "建设单位",
      "type": "organization",
      "required": true
    },
    {
      "key": "contractor",
      "name": "施工单位",
      "type": "organization",
      "required": true
    },
    {
      "key": "supervisor",
      "name": "监理单位",
      "type": "organization",
      "required": true
    },
    {
      "key": "designer",
      "name": "设计单位",
      "type": "organization",
      "required": false
    },
    {
      "key": "address",
      "name": "工程地址",
      "type": "text",
      "required": false,
      "aliases": ["建设地点", "工程地点", "管线位置", "管线起讫点"]
    },
    {
      "key": "start_date",
      "name": "开工日期",
      "type": "date",
      "required": false
    },
    {
      "key": "finish_date",
      "name": "竣工日期",
      "type": "date",
      "required": false
    },
    {
